# Copy this file to .env.local and fill in your real Supabase project values
# (Supabase Dashboard → Project Settings → API).
#
# NEXT_PUBLIC_* variables are exposed to the browser — that's expected and
# safe for these two specifically, because Row Level Security (see
# supabase/schema.sql) is what actually protects your data, not secrecy of
# these values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The service role key is NOT like the two above — it bypasses Row Level
# Security entirely. Never prefix it with NEXT_PUBLIC_ (that would ship it
# to every visitor's browser). Nothing in this app currently uses it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
